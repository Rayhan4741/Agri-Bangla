# ── AgriBangla server configuration ──────────────────────────────────────────
# Copy to server/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# MongoDB connection string (local, Docker, or MongoDB Atlas free M0 cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/agribangla

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated list of browser origins allowed to call the API.
# Leave empty when the server also serves the built client (same origin).
CORS_ORIGINS=http://localhost:5173

# ── কৃষকবন্ধু AI ─────────────────────────────────────────────────────────────
# Free key from Google AI Studio: https://aistudio.google.com/apikey
# Kept on the server only; it is never sent to browsers.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional backup provider (any OpenAI-compatible API, e.g. Groq or OpenRouter).
# Used only if Gemini is not configured or fails.
FALLBACK_AI_BASE_URL=
FALLBACK_AI_API_KEY=
FALLBACK_AI_MODEL=

# Per-IP limits that protect your free AI quota
AI_CHAT_PER_MINUTE=12
AI_CHAT_PER_DAY=150
AI_DIAGNOSE_PER_MINUTE=4
AI_DIAGNOSE_PER_DAY=30

# ── Market prices (TCB) ─────────────────────────────────────────────────────
# The TCB website's robots.txt disallows automated collection, so prices are
# uploaded by an admin. Only switch this on if TCB has permitted automated access;
# the fetcher still checks robots.txt before every request.
TCB_AUTOFETCH=false
TCB_LIST_URL=https://tcb.gov.bd/pages/daily-rmps
TCB_FETCH_HOUR_BD=15

# ── First admin account (used by `npm run create-admin`) ────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
