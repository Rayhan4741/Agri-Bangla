{
  "name": "agribangla-server",
  "version": "2.0.0",
  "private": true,
  "description": "AgriBangla API — Express + MongoDB (Mongoose) backend for the কৃষিবাংলা MERN app.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "create-admin": "tsx --env-file-if-exists=.env src/scripts/createAdmin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "agribangla": "file:..",
    "bcryptjs": "3.0.2",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.19.1",
    "multer": "2.0.2",
    "pdfjs-dist": "4.10.38",
    "robots-parser": "3.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.8",
    "@types/pdfkit": "0.17.3",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.2.3",
    "pdfkit": "0.17.2",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
